module TrafficLight(
input clk,
input waitBtn,
output red,
output yellow,
output green
);

reg [2:0]state;
reg [2:0]nextState;

localparam red = 0, redyellow = 1, green = 2, blink = 3, yellow = 1;

always @*
begin

	case (state)
	
	red:
	begin
		red = 1'b1;
	end
	redyellow:
	begin
		red = 1'b1;
	end
	green:
	begin
		green = 1'b1;
	end
	blink:
	begin
		green = 1'b1;
	end
	yellow:
	begin
		yellow = 1'b1;
	end
	
	endcase

end

endmodule