{
    "scopeName": "source.myLang",
    "name": "myLang",
    "patterns": [
      { "include": "#comments" },
      { "include": "#keywords" },
      { "include": "#types" },
      { "include": "#numbers" },
      { "include": "#strings" },
      { "include": "#operators" },
      { "include": "#identifiers" },
      { "include": "#brackets" }
    ],
  
    "repository": {
      "comments": {
        "patterns": [
          {
            "name": "comment.line.double-slash.myLang",
            "match": "//.*$"
          },
          {
            "name": "comment.block.myLang",
            "begin": "/\\*",
            "end": "\\*/"
          }
        ]
      },
  
      "keywords": {
        "patterns": [
          {
            "name": "keyword.control.myLang",
            "match": "\\b(func|var|if|else|while|print|call)\\b"
          }
        ]
      },
  
      "types": {
        "patterns": [
          {
            "name": "storage.type.myLang",
            "match": "\\bint|bool\\b"
          }
        ]
      },
  
      "numbers": {
        "patterns": [
          {
            "name": "constant.numeric.myLang",
            "match": "\\b[0-9]+\\b"
          }
        ]
      },
  
      "strings": {
        "patterns": [
          {
            "name": "string.quoted.double.myLang",
            "begin": "\"",
            "end": "\""
          }
        ]
      },
  
      "operators": {
        "patterns": [
          {
            "name": "keyword.operator.myLang",
            "match": "(\\+|\\-|\\*|\\/|%|==|!=|<=|>=|<|>|=)"
          }
        ]
      },
  
      "identifiers": {
        "patterns": [
          {
            "name": "variable.other.myLang",
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
          }
        ]
      },
  
      "brackets": {
        "patterns": [
          {
            "name": "punctuation.section.block.begin.myLang",
            "match": "{"
          },
          {
            "name": "punctuation.section.block.end.myLang",
            "match": "}"
          },
          {
            "name": "punctuation.section.parens.begin.myLang",
            "match": "\\("
          },
          {
            "name": "punctuation.section.parens.end.myLang",
            "match": "\\)"
          }
        ]
      }
    },
  
    "fileTypes": [
      "my",
      "mylang"
    ],
    "uuid": "c93e1b8e-98b1-4bb0-8735-158c03e937cc"
  }
  